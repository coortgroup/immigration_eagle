{
  "name": "immigration-eagle",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Immigration Eagle \u2014 Expo app and GitHub Pages website",
  "repository": "https://github.com/coortgroup/immigration_eagle.git",
  "homepage": "https://coortgroup.github.io/immigration_eagle/",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "ios:build": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/check-preparation.cjs && node scripts/check-native.cjs",
    "build:web": "node scripts/export-web.mjs",
    "build:site": "node scripts/build-website.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:site",
    "preview:site": "node scripts/serve-site.mjs",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "doctor": "npx expo-doctor",
    "eas:development": "npx eas-cli build --platform ios --profile development",
    "eas:testflight": "npx eas-cli build --platform ios --profile production",
    "eas:submit": "npx eas-cli submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.37",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
