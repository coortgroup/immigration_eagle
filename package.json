{
  "name": "fillout-immigration-forms",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "description": "FILLOUT IMMIGRATION FORMS \u2014 Expo app and GitHub Pages website",
  "repository": "https://github.com/coortgroup/immigration_eagle.git",
  "homepage": "https://fillout.net/",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "ios:build": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/check-preparation.cjs && node scripts/check-native.cjs && node scripts/check-draft-storage.cjs && node scripts/check-local-api.mjs && npm run test:cloud",
    "build:web": "node scripts/export-web.mjs",
    "build:site": "node scripts/build-website.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:site && npm run check:site",
    "preview:site": "node scripts/serve-site.mjs",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "doctor": "npx expo-doctor",
    "eas:development": "npx eas-cli build --platform ios --profile development",
    "eas:testflight": "npx eas-cli build --platform ios --profile production",
    "eas:submit": "npx eas-cli submit --platform ios --profile production",
    "local": "npm run build && npm run local:serve",
    "local:serve": "node scripts/serve-local.mjs",
    "check:site": "node scripts/check-site.mjs",
    "start:remote": "node scripts/start-expo-remote.mjs",
    "eas:preview": "npx eas-cli@latest update --branch preview --environment preview --platform all",
    "test:cloud": "node scripts/check-cloud-intake.mjs && node scripts/check-cloud-client.cjs && node scripts/check-ai.mjs",
    "test:pdf": "node scripts/check-uscis-questionnaire.cjs && node scripts/uscis-pdf-engine-check.cjs && node scripts/check-official-pdf-document.cjs && node scripts/check-document-delivery.cjs && node scripts/check-full-session.cjs && node scripts/check-free-pdf.cjs && node scripts/check-free-flow.cjs",
    "build:pdf-editor": "node scripts/build-pdf-editor.mjs",
    "prestart": "npm run build:pdf-editor",
    "preweb": "npm run build:pdf-editor",
    "preios": "npm run build:pdf-editor",
    "preandroid": "npm run build:pdf-editor",
    "prebuild:web": "npm run build:pdf-editor",
    "preexport:native": "npm run build:pdf-editor"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
