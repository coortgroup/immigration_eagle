{
  "name": "fillout-immigration-forms",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "FILLOUT IMMIGRATION FORMS — Expo app and GitHub Pages website",
  "repository": "https://github.com/coortgroup/immigration_eagle.git",
  "homepage": "https://fillout.net/",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "ios:build": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node scripts/check-preparation.cjs && node scripts/check-native.cjs && node scripts/check-draft-storage.cjs && node scripts/check-local-api.mjs",
    "build:web": "node scripts/export-web.mjs",
    "build:site": "node scripts/build-website.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:site && npm run check:site",
    "preview:site": "node scripts/serve-site.mjs",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "doctor": "npx expo-doctor",
    "eas:development": "npx eas-cli build --platform ios --profile development",
    "eas:testflight": "npx eas-cli build --platform ios --profile production",
    "eas:submit": "npx eas-cli submit --platform ios --profile production",
    "local": "npm run build && npm run local:serve",
    "local:serve": "node scripts/serve-local.mjs",
    "check:site": "node scripts/check-site.mjs",
    "start:remote": "node scripts/start-expo-remote.mjs",
    "eas:preview": "npx eas-cli@latest update --branch preview --environment preview --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.27",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
