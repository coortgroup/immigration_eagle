# Public client configuration only. These values are bundled into the app.
# Leave blank for the existing offline/local preview.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after server deployment and a successful staging smoke test.
EXPO_PUBLIC_ENABLE_LIVE_AI=false

# Native AI checkout: enable only after the server, store products, and sandbox tests are ready.
# Expo Go and web do not support this checkout. A new native build is required.
EXPO_PUBLIC_ENABLE_AI_PAYMENTS=false
# Public platform SDK keys from RevenueCat. Never use a secret sk_ key or a test-store key here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Product IDs and per-case fulfillment belong in the server's allowlisted product catalog.
# Do not advertise a hardcoded USD preview amount as the actual localized checkout price.

# Do NOT put OPENAI_API_KEY, SUPABASE_SECRET_KEY or a service-role key here.
# Store server credentials in Supabase's Edge Function secrets manager.
