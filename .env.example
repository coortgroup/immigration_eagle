# Public client configuration only. These values are bundled into the app.
# Leave blank for the existing offline/local preview.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after server deployment and a successful staging smoke test.
EXPO_PUBLIC_ENABLE_LIVE_AI=false

# Do NOT put OPENAI_API_KEY, SUPABASE_SECRET_KEY or a service-role key here.
# Store server credentials in Supabase's Edge Function secrets manager.
