# Supabase supplies its URL and public/service keys in hosted Edge Functions.
# Add provider secrets only to supabase/functions/.env (ignored by Git), never EXPO_PUBLIC_*.
ALLOW_LOCAL_DEVELOPMENT=false
CORS_ALLOWED_ORIGINS=https://fillout.net,https://www.fillout.net
# Live chat remains disabled until credentials and staging checks are complete.
AI_ENABLED=false
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Purchases stay disabled until real products and store notifications are configured.
AI_PAYMENTS_ENABLED=false
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENVIRONMENT=production
PAYMENTS_STAGING=false
# Server allowlist only. Use actual RC product/app IDs and reviewed consumable store SKUs.
# [{"formId":"I-90","store":"app_store","productId":"<store-sku>","revenueCatProductId":"<rc-product-id>","appId":"<rc-app-id>"}]
REVENUECAT_PRODUCTS_JSON=[]
# At least 32 characters each. Enable HMAC signing in the RevenueCat webhook integration.
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# For a separate LOCAL Supabase stack only:
# ALLOW_LOCAL_DEVELOPMENT=true
# CORS_ALLOWED_ORIGINS=http://localhost:4175,http://127.0.0.1:4175
