# Supabase supplies its URL and public/service keys in hosted Edge Functions.
# Add provider secrets only to supabase/functions/.env (ignored by Git), never EXPO_PUBLIC_*.
ALLOW_LOCAL_DEVELOPMENT=false
CORS_ALLOWED_ORIGINS=https://fillout.net,https://www.fillout.net
# For a separate LOCAL Supabase stack only:
# ALLOW_LOCAL_DEVELOPMENT=true
# CORS_ALLOWED_ORIGINS=http://localhost:4175,http://127.0.0.1:4175
